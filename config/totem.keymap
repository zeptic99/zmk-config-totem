#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NUM  1
#define NAV  2
#define ADJ  3
#define QWE  4
#define EDIT 5

/* ----------------- Achordion / Chordal Hold Key Position Sets ----------------- */
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37
#define THUMBS 32 33 34 35 36 37

/ {
    /* ----------------- Tri-Layer Setup (Layer 1 + 2 = Layer 3) ----------------- */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUM NAV>;
            then-layer = <ADJ>;
        };
    };

    /* ----------------- Combos (Translated from key_combos[]) ----------------- */
    combos {
        compatible = "zmk,combos";

        combo_q {
            timeout-ms = <50>;
            key-positions = <1 2>; // W + G
            bindings = <&kp Q>;
        };

        combo_z {
            timeout-ms = <50>;
            key-positions = <2 3>; // G + M
            bindings = <&kp Z>;
        };

        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <6 7 8>; // DOT + QUOT + EQL
            bindings = <&caps_word>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <1 2 3>; // W + G + M
            bindings = <&kp TAB>;
        };

        combo_ctrl_bspc {
            timeout-ms = <50>;
            key-positions = <6 7>; // DOT + QUOT
            bindings = <&kp LC(BSPC)>;
        };

        combo_enter {
            timeout-ms = <50>;
            key-positions = <16 17 18>; // A + E + I
            bindings = <&kp RET>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <7 8>; // QUOT + EQL
            bindings = <&kp ESC>;
        };

        combo_comma {
            timeout-ms = <15 16>; // OSM(LSFT) + A
            key-positions = <15 16>;
            bindings = <&kp COMMA>;
        };

        combo_bspc {
            timeout-ms = <50>;
            key-positions = <8 9>; // EQL + SLSH
            bindings = <&kp BSPC>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <6 8>; // DOT + EQL
            bindings = <&kp DEL>;
        };
    };

    /* ----------------- Custom Behaviors ----------------- */
    behaviors {
        // Chordal Hold / Permissive Hold: Left Hand Home-Row Mods
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Chordal Hold / Permissive Hold: Right Hand Home-Row Mods
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Hold-on-other-key-press behavior (for SFT_T(S), MT(RSFT, C), etc.)
        hp: hold_preferred_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Layer-Tap for Thumbs (LT(1, R))
        lt_thumb: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Layer-Mod emulation for LM(4, MOD_LGUI): Hold = Layer 4 + LGUI, Tap = LGUI
        lm_gui: layer_mod_gui {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo_gui>, <&kp>;
        };
    };

    macros {
        mo_gui: mo_gui_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo QWE &kp LGUI>
                , <&macro_pause_for_release>
                , <&macro_release &mo QWE &kp LGUI>;
        };
    };

    /* ----------------- Keymap Layers ----------------- */
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Base Layout (Zeptic / Engram derivative)
        base_layer {
            bindings = <
                &kp V        &kp W        &kp G        &kp M            &kp J                       &kp SEMI       &kp DOT      &kp SQT      &kp EQUAL    &kp FSLH
                &hp LSHFT S  &kp N        &kp T        &kp H            &kp K                       &sk LSHFT      &kp A        &kp E        &kp I        &hp RSHFT C
        &none   &kp F        &kp P        &kp D        &kp L            &kp X                       &kp MINUS      &kp U        &kp O        &kp Y        &kp B         &none
                                          &kp LALT     &lm_gui 0 LGUI   &lt_thumb NUM R             &hp LCTRL SPACE &mo NAV     &kp RALT
            >;
        };

        // Layer 1: Numbers & Symbols
        num_layer {
            bindings = <
                &sk RALT     &kp AT       &kp ASTRK    &sk RCTRL        &sk RGUI                    &sk RSHFT      &kp EXCL     &kp HASH     &sk LCTRL    &sk LGUI
                &kp TILDE    &kp DLLR     &kp PLUS     &kp N0           &kp AMPS                    &kp PIPE       &kp N1       &kp MINUS    &kp UNDER    &kp PRCNT
        &none   &kp N6       &kp N7       &kp N8       &kp N9           &none                       &kp TILDE      &kp N2       &kp N3       &kp N4       &kp N5        &none
                                          &none        &hp LSHFT K      &kp J                       &hp LSHFT J    &trans       &trans
            >;
        };

        // Layer 2: Navigation & Brackets
        nav_layer {
            bindings = <
                &sk RCTRL    &sk RSHFT    &kp LBKT     &kp LC(EQUAL)    &kp LC(MINUS)               &kp PG_DN      &kp CARET    &kp LEFT     &kp RIGHT    &kp NON_US_HASH
                &kp GRAVE    &kp DLLR     &kp LBRC     &kp N0           &kp AMPS                    &kp PIPE       &kp N1       &kp UP       &kp DOWN     &kp PRCNT
        &none   &kp N6       &kp N7       &kp N8       &kp N9           &none                       &kp PG_UP      &kp N2       &kp N3       &kp N4       &kp N5        &none
                                          &sk LALT     &kp RBRC         &kp RBRC                    &none          &trans       &trans
            >;
        };

        // Layer 3: Function & Adjust (Activated automatically via Tri-Layer)
        adj_layer {
            bindings = <
                &kp F1       &kp LBKT     &kp RBKT     &bootloader      &kp F7                      &kp F10        &bootloader  &kp RPAR     &kp LPAR     &kp F4
                &kp F2       &kp LBRC     &kp RCBR     &sys_reset       &kp F8                      &kp F11        &sys_reset   &kp DQT      &kp DQT      &kp F5
        &none   &kp F3       &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1     &bt BT_SEL 2                &kp F12        &out OUT_TOG &kp GT       &kp LT       &kp F6        &none
                                          &none        &none            &trans                      &kp COLON      &kp SEMI     &none
            >;
        };

        // Layer 4: Gaming / QWERTY
        qwe_layer {
            bindings = <
                &kp Q        &kp W        &kp E        &kp R            &kp T                       &kp Y          &kp U        &kp I        &kp O        &kp P
                &hp LSHFT A  &kp S        &kp D        &kp F            &kp G                       &kp H          &kp J        &kp K        &kp L        &kp SEMI
        &none   &hp LCTRL Z  &kp X        &kp C        &kp V            &kp B                       &kp N          &kp M        &kp COMMA    &kp DOT      &kp FSLH      &none
                                          &trans       &kp LSHFT        &mo QWE                     &mo NAV        &kp SPACE    &mo ADJ
            >;
        };

        // Layer 5: Media / Quick Editing Shortcuts
        edit_layer {
            bindings = <
                &trans       &trans       &trans       &trans           &trans                      &trans         &trans       &trans       &trans       &trans
                &hp LSHFT A  &kp S        &kp D        &kp F            &kp G                       &kp H          &kp J        &kp K        &kp L        &kp SEMI
        &none   &trans       &kp LC(Z)    &kp LC(X)    &kp LC(C)        &kp LC(V)                   &kp N          &kp M        &kp COMMA    &kp DOT      &kp FSLH      &none
                                          &trans       &trans           &kp LSHFT                   &mo NAV        &trans       &mo ADJ
            >;
        };
    };
};
